# Environment variables. For production, set these as Edge Function secrets
# (`supabase secrets set ...`) or in the dashboard. Never commit real values.

# --- Supabase (Dashboard > Project Settings > API) ---
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the frontend (GitHub Pages); line-callback redirects back here.
PUBLIC_APP_URL=https://YOUR-USER.github.io/housekeeper/

# --- Notifier (pluggable): "log" (default) or "line" ---
NOTIFIER_PROVIDER=log

# --- LINE Messaging API (only needed when NOTIFIER_PROVIDER=line) ---
LINE_CHANNEL_ACCESS_TOKEN=your-messaging-api-channel-access-token
LINE_CHANNEL_SECRET=your-messaging-api-channel-secret

# --- LINE Login (binds a user's line_user_id) ---
LINE_LOGIN_CHANNEL_ID=your-login-channel-id
LINE_LOGIN_CHANNEL_SECRET=your-login-channel-secret
# Must match the LINE Developers console and frontend/config.js.
LINE_LOGIN_REDIRECT_URI=https://YOUR-REF.supabase.co/functions/v1/line-callback

# --- Affiliate (pluggable): "passthrough" (default) or "affiliatesone" ---
AFFILIATE_PROVIDER=passthrough
AFFILIATESONE_API_KEY=
AFFILIATESONE_SITE_ID=

# LINE free tier is 200 messages/month; dispatch stops sending near this.
LINE_MONTHLY_QUOTA=200
