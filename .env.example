# ─────────────────────────────────────────────────────────────
# Housekeeper 環境變數範本
# 複製成 .env 後填入真實值；正式環境用 `supabase secrets set` 設定給 Edge Functions。
# 切勿把真實金鑰提交進 git。
# ─────────────────────────────────────────────────────────────

# --- Supabase ---
# 從 Supabase Dashboard > Project Settings > API 取得
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 前端 web function 對外的公開網址（給 Magic Link / LINE redirect 用）
# 例：https://YOUR-PROJECT-ref.functions.supabase.co/web
PUBLIC_APP_URL=https://YOUR-PROJECT-ref.functions.supabase.co/web

# --- LINE Messaging API（官方帳號，用來推播）---
LINE_CHANNEL_ACCESS_TOKEN=your-messaging-api-channel-access-token
LINE_CHANNEL_SECRET=your-messaging-api-channel-secret

# --- LINE Login（用來綁定使用者的 line_user_id）---
LINE_LOGIN_CHANNEL_ID=your-login-channel-id
LINE_LOGIN_CHANNEL_SECRET=your-login-channel-secret
# LINE Login callback，需與 LINE Developers Console 設定一致
# 例：https://YOUR-PROJECT-ref.functions.supabase.co/line-callback
LINE_LOGIN_REDIRECT_URI=https://YOUR-PROJECT-ref.functions.supabase.co/line-callback

# --- 分潤（聯盟行銷）---
# MVP 先用 passthrough（原連結直傳）；拿到聯盟網憑證後改成 affiliatesone
AFFILIATE_PROVIDER=passthrough
# 之後才需要（AFFILIATE_PROVIDER=affiliatesone 時）
AFFILIATESONE_API_KEY=
AFFILIATESONE_SITE_ID=

# --- 推播護欄 ---
# LINE Messaging API 免費方案每月 200 則；接近時停送以免超額
LINE_MONTHLY_QUOTA=200
